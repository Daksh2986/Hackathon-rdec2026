{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PS05: Create virtual environment",
      "type": "process",
      "command": "py",
      "args": [
        "-m",
        "venv",
        ".venv"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PS05: Install project in virtual environment",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-e",
        "."
      ],
      "dependsOn": "PS05: Create virtual environment",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
